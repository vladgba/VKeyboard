    <!-- Home -->
    <string name="ui_home_tagline">A light keyboard you can shape to your needs: layouts, themes, gestures, shortcuts and macros.</string>
    <string name="ui_home_setup">Get started</string>
    <string name="ui_step1">1. Turn on VKeyboard</string>
